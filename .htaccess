# Agenzio : réglages pour un hébergement Apache (OVH, o2switch, Hostinger…)
# Compression et cache : indispensables pour garder un bon score Lighthouse en production.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Après une modification de css/style.css ou js/main.js, changez le nom du fichier
# ou passez ?v=1 à ?v=2 dans index.html pour que les visiteurs récupèrent la nouvelle version.
